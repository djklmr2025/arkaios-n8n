        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Eres ELEMIA, sistema de seguridad y análisis del ecosistema ARKAIOS. Analiza este evento entrante y clasifícalo.\\n\\nEVENT_TYPE: {{ $('Webhook').first().json.body.EVENT_TYPE || 'UNKNOWN' }}\\nSOURCE_IP: {{ $('Webhook').first().json.body.SOURCE_IP || 'desconocida' }}\\nNOTES: {{ $('Webhook').first().json.body.NOTES || '' }}\\n\\nResponde SOLO con un JSON válido sin markdown, sin explicaciones adicionales, con exactamente este formato:\\n{\\\"classification\\\": \\\"AMENAZA|ACTIVIDAD_NORMAL|EVENTO_CRITICO|AGENTE_AUTORIZADO\\\", \\\"confidence\\\": 0.95, \\\"summary\\\": \\\"Una línea explicando el evento\\\", \\\"action\\\": \\\"REGISTRAR|ALERTAR|BLOQUEAR|MONITOREAR\\\"}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"maxOutputTokens\": 256\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 300],
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "ELEMIA — Gemini HTTP"
    },
    {
      "parameters": {
        "jsCode": "// Parsear respuesta de Gemini y preparar fila para Sheets\nconst geminiResponse = $input.first().json;\n\n// Extraer el texto de la respuesta de Gemini\nlet rawText = '';\ntry {\n  rawText = geminiResponse.candidates[0].content.parts[0].text || '';\n} catch(e) {\n  rawText = JSON.stringify(geminiResponse);\n}\n\n// Parsear el JSON que devuelve Gemini\nlet analysis = {\n  classification: 'SIN_CLASIFICAR',\n  confidence: 0,\n  summary: rawText.substring(0, 200),\n  action: 'REGISTRAR'\n};\n\ntry {\n  const clean = rawText.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(clean);\n  analysis = { ...analysis, ...parsed };\n} catch(e) {\n  analysis.summary = rawText.substring(0, 300);\n}\n\n// Datos originales del webhook\nconst body = $('Webhook').first().json.body || {};\nconst headers = $('Webhook').first().json.headers || {};\n\nreturn [{\n  json: {\n    TIMESTAMP: new Date().toISOString(),\n    EVENT_TYPE: body.EVENT_TYPE || 'UNKNOWN',\n    SOURCE_IP: body.SOURCE_IP || headers['x-forwarded-for'] || 'N/A',\n    PAYLOAD: JSON.stringify(body.PAYLOAD || {}),\n    STATUS: analysis.action,\n    NOTES: body.NOTES || '',\n    IA_ANALYSIS: `[${analysis.classification}] ${analysis.summary} (confianza: ${Math.round((analysis.confidence || 0) * 100)}%)`,\n    IA_CLASSIFICATION: analysis.classification,\n    IA_ACTION: analysis.action,\n    IA_CONFIDENCE: String(analysis.confidence || 0)\n  }\n}];"
      },
